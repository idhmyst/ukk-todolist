# ========================================================
# Konfigurasi Database To-Do List (PostgreSQL Cloud vs Local)
# ========================================================

# --------------------------------------------------------
# PILIHAN 1: CLOUD POSTGRESQL (GRATIS & TIDAK PERLU INSTAL APAPUN)
# Provider Rekomendasi:
# 1. NEON (https://neon.tech) -> Gratis selamanya, instan, tinggal copy URL
# 2. SUPABASE (https://supabase.com) -> Gratis
# --------------------------------------------------------
DATABASE_URL=postgresql://user:password@ep-sample-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# --------------------------------------------------------
# PILIHAN 2: POSTGRESQL LOKAL (JIKA MENGGUNAKAN PGADMIN / DOCKER)
# --------------------------------------------------------
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_USER=postgres
# DB_PASSWORD=postgres
# DB_NAME=todo_db
# DB_SSLMODE=disable

# Port Server Backend
PORT=8080
FRONTEND_URL=https://kelarin-eight.vercel.app,http://localhost:5173
