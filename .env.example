# ========================================================
# Konfigurasi Database To-Do List (Lokal vs Cloud)
# ========================================================

# --------------------------------------------------------
# CONTOH 1: CLOUD DATABASE (TIDB CLOUD - GRATIS & DIREKOMENDASIKAN)
# Daftar gratis tanpa kartu kredit di https://tidbcloud.com
# --------------------------------------------------------
# DB_HOST=gateway01.ap-southeast-1.prod.aws.tidbcloud.com
# DB_PORT=4000
# DB_USER=2xxxxxx.root
# DB_PASSWORD=your_tidb_password
# DB_NAME=todo_db
# DB_SSL=true

# --------------------------------------------------------
# CONTOH 2: CLOUD DATABASE VIA FULL DSN (AIVEN / RAILWAY)
# --------------------------------------------------------
# DB_DSN=avnadmin:password@tcp(mysql-xxxxx.aivencloud.com:12345)/defaultdb?charset=utf8mb4&parseTime=True&loc=Local&tls=true

# --------------------------------------------------------
# CONTOH 3: DATABASE LOKAL (DEFAULT LARAGON)
# --------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=todo_db
DB_SSL=false

# Port Server Backend
PORT=8080

